# Copy to hexis.env (git ignores it) and fill in the two values Hexis gave you,
# or just run arise.sh --hexis / ascend.sh migrate at a terminal: they ask for
# whatever is missing and offer to write this file for you. The metrics string
# is the same for every Hexis host, so one file serves all your servers.
# The scripts read this file; they never run it. The environment and the
# --hexis-jup-key / --hexis-metrics-config flags take precedence over it.
HEXIS_JUP_KEY="<jupiter-api-key>"
SOLANA_METRICS_CONFIG_ARB="host=https://<metrics-host>,db=<db>,u=<user>,p=<password>"
